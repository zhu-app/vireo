# Vireo 环境变量示例 —— 复制为 apps/api/.env（本地）或 infra/.env（Docker）后按需填写
# ===== 服务 =====
PORT=8080
# 数据库/上传目录（默认 ./data）
DATA_DIR=./data
# JWT 签名密钥 —— 必填！生产环境务必改为随机长字符串（≥16 位），生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 首次启动创建的管理员密码 —— 生产必填；未设置时生产模式不会创建管理员
DEFAULT_ADMIN_PASSWORD=
# 跨域前端来源（同源 Nginx 部署留空即可；前后端分域时填逗号分隔的 https 源）
CORS_ORIGINS=
# 上游模型调用整体超时（毫秒，默认 120000）
# UPSTREAM_TIMEOUT_MS=120000
# 登录/注册限流阈值（每分钟/每 15 分钟窗口，一般不用改）
# LOGIN_RATE_MAX=10
# AUTH_RATE_MAX=20

# ===== 模型服务（可选：平台级兜底 Key，用户也可在设置页填自己的） =====
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
# 自定义网关/私有化部署时覆盖上游地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 联网搜索（可选，Tavily） =====
SEARCH_API_KEY=
# SEARCH_ENDPOINT=https://api.tavily.com/search
